<Project>
	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<PackageIcon>logo.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<TargetFrameworks>net8.0-windows</TargetFrameworks>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<LangVersion>12.0</LangVersion>
		<Version>1.0.0</Version>
		<FileVersion>1.0.0</FileVersion>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<Copyright>Copyright © Wisdom Honest 2025</Copyright>
		<Authors>Wisdom Honest Team</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Wisdom Vision Pro - Professional Computer Vision Solution 基于OpenCVSharp的智能视觉处理系统，使用WPF-Control框架开发，特别感谢原作者HeBianGu</Description>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="**\*.png" />
		<Resource Include="**\*.jpg" />
		<Resource Include="**\*.cur" />
		<Resource Include="**\*.ico" />
		<Resource Include="**\*.bmp" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\Document\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>